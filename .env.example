# ---- Core ----------------------------------------------------------------
APP_ENV=development                 # development | production
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# PostgreSQL (SQLite is used if empty, dev only). postgres:// URLs are auto-converted.
DATABASE_URL=postgresql://rc:rc@localhost:5432/resume_copilot
AUTO_CREATE_DB=1                    # dev convenience; in production use `flask db upgrade`

# ---- AI (optional) -------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b      # primary model
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-20b
# gpt-oss is text-only, so job SCREENSHOTS are read by a vision model first, then gpt-oss writes the message
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_VISION_FALLBACKS=meta-llama/llama-4-maverick-17b-128e-instruct

# ---- Job / paper sources (all optional) ----------------------------------
# Remotive, Arbeitnow, RemoteOK, Jobicy, The Muse, arXiv, OpenAlex need NO key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
CONTACT_EMAIL=you@example.com       # sent in User-Agent / OpenAlex polite pool
AUTO_REFRESH_SOURCES=1

# ---- Rate limiting -------------------------------------------------------
# memory:// is per-worker. Use Redis when running several workers/instances.
RATELIMIT_STORAGE_URI=memory://
